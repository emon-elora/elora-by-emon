{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elora-by-emon",
  "compatibility_date": "2026-09-30",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elora-by-emon-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
